
pipeline {
    agent any

    options {
        timeout(time: 1, unit: 'HOURS')
        disableConcurrentBuilds()
        timestamps()
    }

    environment {
        DOCKER_IMAGE = 'abdessalem123/devops-appgestiondesprojets'
        DOCKER_TAG = "${BUILD_NUMBER}"

        K8S_NAMESPACE = 'devops'
        K8S_CONTEXT = 'minikube'
    }

    stages {

        stage('1. Checkout SCM') {
            steps {
                echo '=== Extraction du code source ==='
                checkout scm
            }
        }

        stage('2. Build & Test Backend') {
            steps {
                dir('backend') {
                    echo '=== Compilation et tests avec JaCoCo ==='

                    sh '''
                        set -e
                        mvn clean test jacoco:report \
                            -Dspring.profiles.active=test

                        test -f target/site/jacoco/jacoco.xml

                        echo "Rapport JaCoCo généré :"
                        ls -lh target/site/jacoco/
                    '''
                }
            }

            post {
                always {
                    junit(
                        allowEmptyResults: true,
                        testResults: 'backend/target/surefire-reports/*.xml'
                    )

                    archiveArtifacts(
                        artifacts: 'backend/target/site/jacoco/**',
                        allowEmptyArchive: true,
                        fingerprint: true
                    )
                }
            }
        }

        stage('3. Analyse SonarQube') {
            steps {
                dir('backend') {
                    echo '=== Analyse SonarQube avec JaCoCo ==='

                    withSonarQubeEnv('SonarQube') {
                        sh '''
                            mvn sonar:sonar \
                              -Dsonar.coverage.jacoco.xmlReportPaths=target/site/jacoco/jacoco.xml
                        '''
                    }
                }
            }
        }

        stage('4. Quality Gate') {
            steps {
                timeout(time: 10, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('5. Package Backend') {
            steps {
                dir('backend') {
                    echo '=== Génération du JAR ==='
                    sh 'mvn package -DskipTests'
                }
            }
        }

        stage('6. Build Frontend') {
            steps {
                dir('frontend') {
                    echo '=== Build Angular ==='
                    sh '''
                        set -e
                        npm install
                        npm run build
                    '''
                }
            }
        }

        stage('7. Archivage') {
            steps {
                archiveArtifacts(
                    artifacts: 'backend/target/*.jar',
                    allowEmptyArchive: false,
                    fingerprint: true
                )
            }
        }

        stage('8. Docker Build') {
            steps {
                echo '=== Construction des images ==='

                sh '''
                    set -e

                    docker build \
                      -f backend/Dockerfile \
                      -t ${DOCKER_IMAGE}:${DOCKER_TAG} \
                      -t ${DOCKER_IMAGE}:latest \
                      backend

                    docker build \
                      -f frontend/Dockerfile \
                      -t ${DOCKER_IMAGE}-frontend:${DOCKER_TAG} \
                      -t ${DOCKER_IMAGE}-frontend:latest \
                      frontend
                '''
            }
        }

        stage('9. Docker Hub') {
            steps {
                echo '=== Publication sur Docker Hub ==='

                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockerhub-credentials',
                        usernameVariable: 'DOCKER_USERNAME',
                        passwordVariable: 'DOCKER_PASSWORD'
                    )
                ]) {
                    sh '''
                        set -eu
                        set +x

                        echo "$DOCKER_PASSWORD" | docker login \
                          --username "$DOCKER_USERNAME" \
                          --password-stdin

                        docker push ${DOCKER_IMAGE}:${DOCKER_TAG}
                        docker push ${DOCKER_IMAGE}:latest

                        docker push ${DOCKER_IMAGE}-frontend:${DOCKER_TAG}
                        docker push ${DOCKER_IMAGE}-frontend:latest

                        docker logout
                    '''
                }
            }
        }

        stage('10. Vérification Minikube') {
            steps {
                echo '=== Vérification du cluster Kubernetes ==='

                sh '''
                    set -e

                    kubectl config use-context ${K8S_CONTEXT}
                    minikube status
                    kubectl cluster-info
                    kubectl get nodes
                '''
            }
        }

        stage('11. Namespace Kubernetes') {
            steps {
                echo '=== Création du namespace ==='

                sh '''
                    kubectl create namespace ${K8S_NAMESPACE} \
                      --dry-run=client -o yaml | kubectl apply -f -
                '''
            }
        }


        stage('12. Configuration MySQL et Spring') {
            steps {
                echo '=== Configuration des accès à la base ==='

                withCredentials([
                    string(
                        credentialsId: 'mysql-root-password',
                        variable: 'MYSQL_ROOT_PASSWORD'
                    ),
                    string(
                        credentialsId: 'mysql-app-password',
                        variable: 'MYSQL_APP_PASSWORD'
                    )
                ]) {
                    sh '''
                        set -eu
                        set +x

                        kubectl create secret generic mysql-secret \
                          --namespace="${K8S_NAMESPACE}" \
                          --from-literal=MYSQL_ROOT_PASSWORD="$MYSQL_ROOT_PASSWORD" \
                          --from-literal=MYSQL_PASSWORD="$MYSQL_APP_PASSWORD" \
                          --dry-run=client -o yaml | kubectl apply -f -

                        kubectl create configmap spring-config \
                          --namespace="${K8S_NAMESPACE}" \
                          --from-literal=SPRING_DATASOURCE_URL='jdbc:mysql://mysql-service:3306/springdb' \
                          --from-literal=SPRING_DATASOURCE_USERNAME='spring' \
                          --dry-run=client -o yaml | kubectl apply -f -
                    '''
                }
            }
        }


        stage('13. Déploiement MySQL') {
            steps {
                echo '=== Déploiement de MySQL et stockage persistant ==='

                sh '''
                    set -e

                    kubectl apply -f k8s/mysql-deployment.yaml \
                      -n ${K8S_NAMESPACE}

                    kubectl rollout status deployment/mysql \
                      -n ${K8S_NAMESPACE} --timeout=240s

                    kubectl wait \
                      --for=condition=Ready pod \
                      -l app=mysql \
                      -n ${K8S_NAMESPACE} \
                      --timeout=120s
                '''
            }
        }

        stage('14. Déploiement Backend et Frontend') {
            steps {
                echo '=== Application des manifestes ==='

                sh '''
                    set -e

                    kubectl apply -f k8s/backend-deployment.yaml \
                      -n ${K8S_NAMESPACE}

                    kubectl apply -f k8s/frontend-deployment.yaml \
                      -n ${K8S_NAMESPACE}

                    kubectl set image deployment/backend \
                      backend=${DOCKER_IMAGE}:${DOCKER_TAG} \
                      -n ${K8S_NAMESPACE}

                    kubectl set image deployment/frontend \
                      frontend=${DOCKER_IMAGE}-frontend:${DOCKER_TAG} \
                      -n ${K8S_NAMESPACE}
                '''
            }
        }

        stage('15. Vérification du déploiement') {
            steps {
                echo '=== Attente du démarrage des Deployments ==='

                sh '''
                    set -e

                    kubectl rollout status deployment/backend \
                      -n ${K8S_NAMESPACE} --timeout=240s

                    kubectl rollout status deployment/frontend \
                      -n ${K8S_NAMESPACE} --timeout=240s

                    echo "=== Pods ==="
                    kubectl get pods -n ${K8S_NAMESPACE} -o wide

                    echo "=== Deployments ==="
                    kubectl get deployments -n ${K8S_NAMESPACE}

                    echo "=== Services ==="
                    kubectl get services -n ${K8S_NAMESPACE}
                '''
            }
        }

        stage('16. Monitoring Kubernetes') {
            steps {
                echo '=== Vérification finale ==='

                sh '''
                    echo "=== Pods ==="
                    kubectl get pods -n ${K8S_NAMESPACE}

                    echo "=== Services ==="
                    kubectl get svc -n ${K8S_NAMESPACE}

                    echo "=== Événements ==="
                    kubectl get events -n ${K8S_NAMESPACE} \
                      --sort-by=.metadata.creationTimestamp

                    echo "=== Images déployées ==="
                    kubectl get deployments -n ${K8S_NAMESPACE} \
                      -o custom-columns='NAME:.metadata.name,IMAGES:.spec.template.spec.containers[*].image'
                '''
            }
        }
    }

    post {
        success {
            echo '=========================================='
            echo 'PIPELINE CI/CD ET DEPLOIEMENT KUBERNETES OK'
            echo '=========================================='
        }

        failure {
            echo '=========================================='
            echo 'ECHEC : consulter les logs du stage en erreur'
            echo '=========================================='
        }

        always {
            echo '=== Nettoyage des anciennes images inutilisées ==='

            sh 'docker image prune -f || true'
        }
    }
}
