pipeline {
    agent any

    options {
        timeout(time: 1, unit: 'HOURS')
        disableConcurrentBuilds()
    }

    stages {
        stage('1. Checkout SCM') {
            steps {
                echo '=== Extraction du code source ==='
                checkout scm
            }
        }

        stage('2. Build & Test Backend (Spring Boot)') {
            steps {
                dir('backend') {
                    echo '=== Compilation et exécution des tests unitaires ==='
                    sh 'mvn clean test -Dspring.profiles.active=test'
                }
            }
            post {
                always {
                    junit allowEmptyResults: true, testResults: 'backend/target/surefire-reports/*.xml'
                }
            }
        }

        stage('3. Analyse Qualité Code (SonarQube)') {
            steps {
                dir('backend') {
                    echo '=== Analyse du code avec SonarQube ==='
                    withSonarQubeEnv('SonarQube') {
                        sh 'mvn sonar:sonar'
                    }
                }
            }
        }

        stage('4. Quality Gate (SonarQube)') {
            steps {
                timeout(time: 900, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('5. Package Backend (JAR)') {
            steps {
                dir('backend') {
                    echo '=== Génération du livrable JAR ==='
                    sh 'mvn package -DskipTests'
                }
            }
        }

        stage('6. Build Frontend (Angular)') {
            steps {
                dir('frontend') {
                    echo '=== Installation des dépendances et build Angular ==='
                    sh 'npm install'
                    sh 'npm run build'
                }
            }
        }

        stage('7. Archivage des Artefacts') {
            steps {
                echo '=== Sauvegarde des livrables dans Jenkins ==='
                archiveArtifacts artifacts: 'backend/target/*.jar', allowEmptyArchive: true, fingerprint: true
            }
        }
    }

    post {
        success {
            echo '🎉 Pipeline CI terminé avec succès !'
        }
        failure {
            echo '❌ Échec du Pipeline CI.'
        }
    }
}
