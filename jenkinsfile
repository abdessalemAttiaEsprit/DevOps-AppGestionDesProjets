pipeline {
    agent any

    options {
        timeout(time: 1, unit: 'HOURS')
        disableConcurrentBuilds()
    }

    environment {
        DOCKER_IMAGE = 'abdessalem123/devops-appgestiondesprojets'
        DOCKER_TAG = "${BUILD_NUMBER}"
    }

    stages {

        stage('1. Checkout SCM') {
            steps {
                echo '=== Extraction du code source ==='
                checkout scm
            }
        }

        stage('2. Build & Test Backend') {
            steps {
                dir('backend') {
                    echo '=== Compilation et tests ==='
                    sh 'mvn clean test -Dspring.profiles.active=test'
                }
            }

            post {
                always {
                    junit(
                        allowEmptyResults: true,
                        testResults: 'backend/target/surefire-reports/*.xml'
                    )
                }
            }
        }

        stage('3. Analyse SonarQube') {
            steps {
                dir('backend') {
                    echo '=== Analyse SonarQube ==='

                    withSonarQubeEnv('SonarQube') {
                        sh 'mvn sonar:sonar'
                    }
                }
            }
        }

        stage('4. Quality Gate') {
            steps {
                timeout(time: 10, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('5. Package Backend') {
            steps {
                dir('backend') {
                    echo '=== Génération du JAR ==='
                    sh 'mvn package -DskipTests'
                }
            }
        }

        stage('6. Build Frontend') {
            steps {
                dir('frontend') {
                    echo '=== Build Angular ==='
                    sh 'npm install'
                    sh 'npm run build'
                }
            }
        }

        stage('7. Archivage') {
            steps {
                echo '=== Archivage du JAR ==='

                archiveArtifacts(
                    artifacts: 'backend/target/*.jar',
                    allowEmptyArchive: true,
                    fingerprint: true
                )
            }
        }

        stage('8. Docker Build') {
            steps {
                echo '=== Construction des images Docker ==='

                sh '''
                    echo "=== Build Backend ==="

                    docker build \
                        -f backend/Dockerfile \
                        -t ${DOCKER_IMAGE}:${DOCKER_TAG} \
                        -t ${DOCKER_IMAGE}:latest \
                        backend


                    echo "=== Build Frontend ==="

                    docker build \
                        -f frontend/Dockerfile \
                        -t ${DOCKER_IMAGE}-frontend:${DOCKER_TAG} \
                        -t ${DOCKER_IMAGE}-frontend:latest \
                        frontend
                '''
            }
        }

        stage('9. Docker Hub') {
            steps {
                echo '=== Push Docker Hub ==='

                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockerhub-credentials',
                        usernameVariable: 'DOCKER_USERNAME',
                        passwordVariable: 'DOCKER_PASSWORD'
                    )
                ]) {
                    sh '''
                        echo "$DOCKER_PASSWORD" | docker login \
                        -u "$DOCKER_USERNAME" \
                        --password-stdin

                    echo "=== Push Backend ==="

                    docker push ${DOCKER_IMAGE}:${DOCKER_TAG}
                    docker push ${DOCKER_IMAGE}:latest

                    echo "=== Push Frontend ==="

                    docker push ${DOCKER_IMAGE}-frontend:${DOCKER_TAG}
                    docker push ${DOCKER_IMAGE}-frontend:latest


                    echo "=== Push Frontend ==="

                    docker push ${DOCKER_IMAGE}-frontend:${DOCKER_TAG}
                    docker push ${DOCKER_IMAGE}-frontend:latest

                    echo "=== Logout ==="
                    docker logout
                '''
            }
        }
    }
}
        stage('DEBUG Workspace') {
            steps {
                sh '''
                    echo "=== WORKSPACE ==="
                    pwd

                    echo "=== FICHIERS ==="
                    ls -la

                    echo "=== DOCKER COMPOSE ==="
                    ls -l docker-compose.yml

                    echo "=== PROMETHEUS ==="
                    ls -l prometheus/prometheus.yml

                    echo "=== DOCKER ==="
                    docker ps
                '''
            }
        }

        stage('10. Docker Compose') {
            steps {
                echo '=== Déploiement Docker Compose ==='

                sh '''
                    echo "=== Vérification Docker Compose ==="
                    docker compose version

                    echo "=== Arrêt des anciens conteneurs ==="
                    docker compose down || true

                    echo "=== Démarrage de l'application ==="
                    docker compose up -d --force-recreate

                    echo "=== État des conteneurs ==="
                    docker compose ps
                '''
            }
}

        stage('11. Monitoring') {
            steps {
                echo '=== Vérification Monitoring ==='

                sh '''
                    docker compose ps

                    docker ps
                '''
            }
        }
    }

    post {

        success {
            echo '=========================================='
            echo '🎉 PIPELINE CI/CD TERMINÉE AVEC SUCCÈS'
            echo '=========================================='
        }

        failure {
            echo '=========================================='
            echo '❌ ÉCHEC DE LA PIPELINE'
            echo '=========================================='
        }

        always {
            echo '=== Nettoyage Docker ==='

            sh '''
                docker image prune -f || true
            '''
        }
    }
}
