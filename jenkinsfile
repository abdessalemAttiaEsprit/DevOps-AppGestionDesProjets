pipeline {
    agent any

    options {
        timeout(time: 1, unit: 'HOURS')
        disableConcurrentBuilds()
        timestamps()
    }

    environment {
        DOCKER_IMAGE  = 'abdessalem123/devops-appgestiondesprojets'
        DOCKER_TAG    = "${BUILD_NUMBER}"
        K8S_NAMESPACE = 'devops'
        K8S_CONTEXT   = 'minikube'
        KUBECONFIG    = '/var/lib/jenkins/.kube/config'
    }

    stages {

        stage('1. Checkout SCM') {
            steps {
                echo '=== Extraction du code source ==='
                checkout scm
            }
        }

        stage('2. Build & Test Backend') {
            steps {
                dir('backend') {
                    sh '''
                        set -eu
                        mvn clean test jacoco:report -Dspring.profiles.active=test
                        test -f target/site/jacoco/jacoco.xml
                        echo "Rapport JaCoCo généré."
                        ls -lh target/site/jacoco/
                    '''
                }
            }
            post {
                always {
                    junit(allowEmptyResults: true,
                          testResults: 'backend/target/surefire-reports/*.xml')
                    archiveArtifacts(artifacts: 'backend/target/site/jacoco/**',
                                     allowEmptyArchive: true,
                                     fingerprint: true)
                }
            }
        }

        stage('3. Analyse SonarQube') {
            steps {
                dir('backend') {
                    withSonarQubeEnv('SonarQube') {
                        sh '''
                            set -eu
                            mvn sonar:sonar \
                              -Dsonar.coverage.jacoco.xmlReportPaths=target/site/jacoco/jacoco.xml
                        '''
                    }
                }
            }
        }

        stage('4. Quality Gate') {
            steps {
                timeout(time: 10, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('5. Package Backend') {
            steps {
                dir('backend') {
                    sh 'mvn package -DskipTests'
                }
            }
        }

        stage('6. Build Frontend') {
            steps {
                dir('frontend') {
                    sh '''
                        set -eu
                        if [ -f package-lock.json ]; then
                            npm ci --no-audit --no-fund
                        else
                            npm install --no-audit --no-fund
                        fi
                        npm run build
                    '''
                }
            }
        }

        stage('7. Archivage') {
            steps {
                archiveArtifacts(artifacts: 'backend/target/*.jar',
                                 allowEmptyArchive: false,
                                 fingerprint: true)
            }
        }

        stage('8. Docker Build') {
            steps {
                sh '''
                    set -eu

                    docker build \
                      -f backend/Dockerfile \
                      -t ${DOCKER_IMAGE}:${DOCKER_TAG} \
                      -t ${DOCKER_IMAGE}:latest \
                      backend

                    docker build \
                      -f frontend/Dockerfile \
                      -t ${DOCKER_IMAGE}-frontend:${DOCKER_TAG} \
                      -t ${DOCKER_IMAGE}-frontend:latest \
                      frontend
                '''
            }
        }

        stage('9. Publication Docker Hub') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockerhub-credentials',
                        usernameVariable: 'DOCKER_USERNAME',
                        passwordVariable: 'DOCKER_PASSWORD'
                    )
                ]) {
                    sh '''
                        set -eu
                        set +x
                        trap 'docker logout' EXIT

                        echo "$DOCKER_PASSWORD" | docker login \
                          --username "$DOCKER_USERNAME" \
                          --password-stdin

                        docker push ${DOCKER_IMAGE}:${DOCKER_TAG}
                        docker push ${DOCKER_IMAGE}:latest
                        docker push ${DOCKER_IMAGE}-frontend:${DOCKER_TAG}
                        docker push ${DOCKER_IMAGE}-frontend:latest
                    '''
                }
            }
        }

        stage('10. Vérification Kubernetes') {
            steps {
                sh '''
                    set -eu
                    echo "=== Identité Jenkins ==="
                    whoami
                    echo "KUBECONFIG=$KUBECONFIG"

                    test -r "$KUBECONFIG"

                    CURRENT_CONTEXT=$(kubectl config current-context)
                    echo "Contexte actuel : $CURRENT_CONTEXT"
                    if [ "$CURRENT_CONTEXT" != "$K8S_CONTEXT" ]; then
                        echo "ERREUR : contexte attendu '$K8S_CONTEXT', actuel '$CURRENT_CONTEXT'"
                        exit 1
                    fi

                    echo "=== Cluster ==="
                    kubectl cluster-info
                    kubectl get --raw='/readyz' ; echo

                    echo "=== Nœuds ==="
                    kubectl wait --for=condition=Ready node --all --timeout=60s
                    kubectl get nodes -o wide
                '''
            }
        }

        stage('11. Namespace Kubernetes') {
            steps {
                sh '''
                    set -eu
                    kubectl create namespace "$K8S_NAMESPACE" \
                      --dry-run=client -o yaml | kubectl apply -f -
                    kubectl get namespace "$K8S_NAMESPACE"
                '''
            }
        }

        stage('12. Configuration MySQL et Spring') {
            steps {
                withCredentials([
                    string(credentialsId: 'mysql-root-password', variable: 'MYSQL_ROOT_PASSWORD'),
                    string(credentialsId: 'mysql-app-password',  variable: 'MYSQL_APP_PASSWORD')
                ]) {
                    sh '''
                        set -eu
                        set +x

                        kubectl create secret generic mysql-secret \
                          --namespace="$K8S_NAMESPACE" \
                          --from-literal=MYSQL_ROOT_PASSWORD="$MYSQL_ROOT_PASSWORD" \
                          --from-literal=MYSQL_PASSWORD="$MYSQL_APP_PASSWORD" \
                          --dry-run=client -o yaml | kubectl apply -f -

                        kubectl create configmap spring-config \
                          --namespace="$K8S_NAMESPACE" \
                          --from-literal=SPRING_DATASOURCE_URL='jdbc:mysql://mysql-service:3306/springdb' \
                          --from-literal=SPRING_DATASOURCE_USERNAME='spring' \
                          --dry-run=client -o yaml | kubectl apply -f -
                    '''
                }
            }
        }

        stage('13. Déploiement MySQL') {
            steps {
                sh '''
                    set -eu
                    kubectl apply -f k8s/mysql-deployment.yaml -n "$K8S_NAMESPACE"
                    kubectl rollout status deployment/mysql -n "$K8S_NAMESPACE" --timeout=900s
                    kubectl wait --for=condition=Ready pod -l app=mysql \
                      -n "$K8S_NAMESPACE" --timeout=900s
                '''
            }
        }


        stage('14. Déploiement Backend et Frontend') {
            steps {
                sh '''
                    set -eu

                    echo "=== Vérification des images ==="
                    docker manifest inspect \
                      "${DOCKER_IMAGE}:${DOCKER_TAG}" >/dev/null
                    docker manifest inspect \
                      "${DOCKER_IMAGE}-frontend:${DOCKER_TAG}" >/dev/null

                    echo "=== Application des manifestes ==="
                    kubectl apply -f k8s/backend-deployment.yaml \
                      -n "$K8S_NAMESPACE"

                    kubectl apply -f k8s/frontend-deployment.yaml \
                      -n "$K8S_NAMESPACE"

                    echo "=== Déploiement Backend ==="
                    kubectl set image deployment/backend \
                      backend="${DOCKER_IMAGE}:${DOCKER_TAG}" \
                      -n "$K8S_NAMESPACE"

                    echo "=== Déploiement Frontend ==="
                    kubectl set image deployment/frontend \
                      frontend="${DOCKER_IMAGE}-frontend:${DOCKER_TAG}" \
                      -n "$K8S_NAMESPACE"

                    echo "=== Images demandées ==="
                    kubectl get deployments -n "$K8S_NAMESPACE" \
                      -o custom-columns='NAME:.metadata.name,IMAGES:.spec.template.spec.containers[*].image'
                '''
            }
        }

        stage('15. Vérification du déploiement') {
            steps {
                sh '''
                    set -eu

                    echo "=== Attente du Backend ==="
                    kubectl rollout status deployment/backend \
                      -n "$K8S_NAMESPACE" --timeout=600s

                    echo "=== Attente du Frontend ==="
                    kubectl rollout status deployment/frontend \
                      -n "$K8S_NAMESPACE" --timeout=600s

                    echo "=== Pods ==="
                    kubectl get pods -n "$K8S_NAMESPACE" -o wide

                    echo "=== Deployments ==="
                    kubectl get deployments -n "$K8S_NAMESPACE"

                    echo "=== Services ==="
                    kubectl get services -n "$K8S_NAMESPACE"
                '''
            }
            post {
                failure {
                    sh '''
                        echo "=== Diagnostic avant rollback ==="

                        kubectl get pods -n "$K8S_NAMESPACE" -o wide || true

                        kubectl get events -n "$K8S_NAMESPACE" \
                          --sort-by=.metadata.creationTimestamp || true

                        for deployment in backend frontend; do
                          echo "=== Description : $deployment ==="
                          kubectl describe deployment "$deployment" \
                            -n "$K8S_NAMESPACE" || true

                          echo "=== Logs des Pods : $deployment ==="
                          kubectl logs deployment/"$deployment" \
                            -n "$K8S_NAMESPACE" --all-containers=true \
                            --tail=100 || true
                        done

                        echo "=== Rollback des déploiements ==="
                        kubectl rollout undo deployment/backend \
                          -n "$K8S_NAMESPACE" || true

                        kubectl rollout undo deployment/frontend \
                          -n "$K8S_NAMESPACE" || true

                        echo "=== État après rollback ==="
                        kubectl get pods -n "$K8S_NAMESPACE" -o wide || true
                    '''
                }
            }
        }


        stage('16. Monitoring Kubernetes') {
            steps {
                sh '''
                    set -eu
                    kubectl get pods -n "$K8S_NAMESPACE"
                    kubectl get svc  -n "$K8S_NAMESPACE"

                    echo "=== Événements ==="
                    kubectl get events -n "$K8S_NAMESPACE" \
                      --sort-by=.metadata.creationTimestamp

                    echo "=== Images déployées ==="
                    kubectl get deployments -n "$K8S_NAMESPACE" \
                      -o custom-columns='NAME:.metadata.name,IMAGES:.spec.template.spec.containers[*].image'
                '''
            }
        }
    }

    post {
        success {
            echo 'PIPELINE CI/CD ET DEPLOIEMENT KUBERNETES OK'
        }
        failure {
            echo 'ECHEC : consulter les logs du stage en erreur'
        }
        always {
            echo '=== Nettoyage des anciennes images inutilisées ==='
            sh 'docker image prune -f || true'
        }
    }
}
