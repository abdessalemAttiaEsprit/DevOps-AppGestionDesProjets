
pipeline {
    agent any

    options {
        timeout(time: 1, unit: 'HOURS')
        disableConcurrentBuilds()
    }

    environment {
        DOCKER_IMAGE = 'abdessalem123/devops-appgestiondesprojets'
        DOCKER_TAG = "${BUILD_NUMBER}"
    }

    stages {

        stage('1. Checkout SCM') {
            steps {
                echo '=== Extraction du code source ==='
                checkout scm
            }
        }

        stage('2. Build & Test Backend') {
            steps {
                dir('backend') {
                    echo '=== Compilation et tests avec JaCoCo ==='

                    sh '''
                        mvn clean test jacoco:report \
                            -Dspring.profiles.active=test
                    '''

                    echo '=== Vérification du rapport JaCoCo ==='

                    sh '''
                        test -f target/site/jacoco/jacoco.xml || {
                            echo "ERREUR : rapport JaCoCo XML introuvable"
                            exit 1
                        }

                        echo "Rapport JaCoCo XML généré avec succès"
                        ls -lh target/site/jacoco/
                    '''
                }
            }

            post {
                always {
                    junit(
                        allowEmptyResults: true,
                        testResults: 'backend/target/surefire-reports/*.xml'
                    )

                    archiveArtifacts(
                        artifacts: 'backend/target/site/jacoco/**',
                        allowEmptyArchive: true,
                        fingerprint: true
                    )
                }
            }
        }

        stage('3. Analyse SonarQube') {
            steps {
                dir('backend') {
                    echo '=== Analyse SonarQube avec JaCoCo ==='

                    withSonarQubeEnv('SonarQube') {
                        sh '''
                            mvn sonar:sonar \
                                -Dsonar.coverage.jacoco.xmlReportPaths=target/site/jacoco/jacoco.xml
                        '''
                    }
                }
            }
        }

        stage('4. Quality Gate') {
            steps {
                timeout(time: 10, unit: 'MINUTES') {
                    waitForQualityGate abortPipeline: true
                }
            }
        }

        stage('5. Package Backend') {
            steps {
                dir('backend') {
                    echo '=== Génération du JAR ==='

                    sh 'mvn package -DskipTests'
                }
            }
        }

        stage('6. Build Frontend') {
            steps {
                dir('frontend') {
                    echo '=== Build Angular ==='

                    sh 'npm install'
                    sh 'npm run build'
                }
            }
        }

        stage('7. Archivage') {
            steps {
                echo '=== Archivage du JAR ==='

                archiveArtifacts(
                    artifacts: 'backend/target/*.jar',
                    allowEmptyArchive: true,
                    fingerprint: true
                )
            }
        }

        stage('8. Docker Build') {
            steps {
                echo '=== Construction des images Docker ==='

                sh '''
                    echo "=== Build Backend ==="

                    docker build \
                        -f backend/Dockerfile \
                        -t ${DOCKER_IMAGE}:${DOCKER_TAG} \
                        -t ${DOCKER_IMAGE}:latest \
                        backend

                    echo "=== Build Frontend ==="

                    docker build \
                        -f frontend/Dockerfile \
                        -t ${DOCKER_IMAGE}-frontend:${DOCKER_TAG} \
                        -t ${DOCKER_IMAGE}-frontend:latest \
                        frontend
                '''
            }
        }

        stage('9. Docker Hub') {
            steps {
                echo '=== Push Docker Hub ==='

                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockerhub-credentials',
                        usernameVariable: 'DOCKER_USERNAME',
                        passwordVariable: 'DOCKER_PASSWORD'
                    )
                ]) {
                    sh '''
                        set +x

                        echo "$DOCKER_PASSWORD" | docker login \
                            -u "$DOCKER_USERNAME" \
                            --password-stdin

                        echo "=== Push Backend ==="

                        docker push ${DOCKER_IMAGE}:${DOCKER_TAG}
                        docker push ${DOCKER_IMAGE}:latest

                        echo "=== Push Frontend ==="

                        docker push ${DOCKER_IMAGE}-frontend:${DOCKER_TAG}
                        docker push ${DOCKER_IMAGE}-frontend:latest

                        echo "=== Logout ==="

                        docker logout
                    '''
                }
            }
        }


        stage('10. Vérification Kubernetes') {
            steps {
                echo '=== Vérification de Minikube ==='

                sh '''
                    set -e

                    kubectl version --client
                    kubectl config current-context
                    kubectl cluster-info
                    kubectl get nodes
                '''
            }
        }

        stage('11. Création du Namespace') {
            steps {
                echo '=== Création du namespace devops ==='

                sh '''
                    kubectl create namespace devops \
                        --dry-run=client -o yaml | kubectl apply -f -
                '''
            }
        }

        stage('12. Déploiement Kubernetes') {
            steps {
                echo '=== Application des manifestes Kubernetes ==='

                sh '''
                    set -e

                    kubectl apply -f k8s/mysql-deployment.yaml
                    kubectl apply -f k8s/backend-deployment.yaml
                    kubectl apply -f k8s/frontend-deployment.yaml
                '''
            }
        }

        stage('13. Mise à jour des images') {
            steps {
                echo '=== Mise à jour des images Docker ==='

                sh '''
                    set -e

                    kubectl set image deployment/backend \
                        backend=${DOCKER_IMAGE}:${DOCKER_TAG} \
                        -n devops

                    kubectl set image deployment/frontend \
                        frontend=${DOCKER_IMAGE}-frontend:${DOCKER_TAG} \
                        -n devops
                '''
            }
        }

        stage('14. Vérification du déploiement') {
            steps {
                echo '=== Attente du démarrage des applications ==='

                sh '''
                    set -e

                    kubectl rollout status deployment/backend \
                        -n devops --timeout=180s

                    kubectl rollout status deployment/frontend \
                        -n devops --timeout=180s

                    kubectl get pods -n devops
                    kubectl get deployments -n devops
                    kubectl get services -n devops
                '''
            }
        }

        stage('15. Monitoring Kubernetes') {
            steps {
                echo '=== État du cluster ==='

                sh '''
                    echo "=== Pods ==="
                    kubectl get pods -n devops -o wide

                    echo "=== Services ==="
                    kubectl get svc -n devops

                    echo "=== Événements récents ==="
                    kubectl get events -n devops \
                        --sort-by=.metadata.creationTimestamp
                '''
            }
        }

    post {

        success {
            echo '=========================================='
            echo 'PIPELINE CI/CD TERMINEE AVEC SUCCES'
            echo '=========================================='
        }

        failure {
            echo '=========================================='
            echo 'ECHEC DE LA PIPELINE'
            echo '=========================================='
        }

        always {
            echo '=== Nettoyage Docker ==='

            sh '''
                docker image prune -f || true
            '''
        }
    }
}
